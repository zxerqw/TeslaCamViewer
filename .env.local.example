# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — it is per-developer config.
#
# Used by `make build-device`, `make install-device`, `make launch-device`,
# `make run-device`.

# REQUIRED: your Apple Developer Team ID (10-char alphanumeric).
# Find it at https://developer.apple.com/account → Membership.
DEVELOPMENT_TEAM=ABCDE12345

# OPTIONAL: the connected device to target.
# Value can be the device name ("侯世莹的iPhone") or its UUID.
# If unset, `make` picks the first non-Watch available device.
# Run `make list-devices` to see options.
#DEVICE_ID=Shanes iPhone
